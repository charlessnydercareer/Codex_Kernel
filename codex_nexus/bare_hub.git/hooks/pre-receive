#!/usr/bin/env bash
# Codex Genesis - Automated Enforcement Engine
# This hook runs before a push is accepted into the bare_hub.

echo "[ENFORCEMENT_ENGINE] Starting security handshake..."

# Navigate to the working tree simulation space since a bare hub has no files
cd ../local_worker || exit 1

# 1. Structural Gate (Algebra Gate)
python3 algebra_gate.py
if [ $? -ne 0 ]; then
    echo "[ENFORCEMENT_ENGINE] REJECTED: Structural violation detected."
    exit 1
fi

# 2. Semantic Gate (AST Scan)
python3 src/ast_gate.py
if [ $? -ne 0 ]; then
    echo "[ENFORCEMENT_ENGINE] REJECTED: Semantic violation detected."
    exit 1
fi

# 3. Network/Topological Gate (Federated Linker)
# Logic: Call linker to verify incoming Merkle proofs.
# (Assume proofs are passed via environment or temporary metadata)
python3 src/federated_linker.py
if [ $? -ne 0 ]; then
    echo "[ENFORCEMENT_ENGINE] REJECTED: Topological boundary breach."
    exit 1
fi

echo "[ENFORCEMENT_ENGINE] All gates passed. Push accepted."
exit 0
